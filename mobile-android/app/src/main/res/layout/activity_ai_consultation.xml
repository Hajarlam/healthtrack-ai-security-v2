<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#023E58"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:contentDescription="Retour" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Sihati AI — Assistant Médical"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Moteur OpenAI GPT-3.5 &amp; Clinique"
                android:textColor="#00B4D8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick suggestions bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E2E8F0"
        android:paddingVertical="8dp"
        android:paddingHorizontal="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_q1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comment faire baisser ma tension ?"
                android:background="#FFFFFF"
                android:textColor="#0077B6"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textSize="11sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_q2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Que faire en cas de mal de tête ?"
                android:background="#FFFFFF"
                android:textColor="#0077B6"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textSize="11sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_q3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conseils glycémie et diabète"
                android:background="#FFFFFF"
                android:textColor="#0077B6"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="8dp"
        android:clipToPadding="false" />

    <!-- Typing indicator -->
    <LinearLayout
        android:id="@+id/layout_typing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminateTint="#0077B6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dr. Sihati AI formule une réponse..."
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Bottom Input Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:elevation="8dp">

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Posez une question sur votre santé..."
            android:textColor="#1E293B"
            android:textColorHint="#94A3B8"
            android:textSize="14sp"
            android:background="#F1F5F9"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:maxLines="3" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_gradient_rose"
            android:src="@android:drawable/ic_menu_send"
            app:tint="#FFFFFF"
            android:layout_marginStart="8dp"
            android:contentDescription="Envoyer" />
    </LinearLayout>
</LinearLayout>
