<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" app:cardCornerRadius="10dp" app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical">
        <TextView android:id="@+id/tv_severity" android:textSize="11sp" android:textStyle="bold"
            android:padding="4dp" android:layout_marginEnd="10dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_message" android:textSize="13sp" android:textColor="#3D2C2C"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tv_date" android:textSize="11sp" android:textColor="#8D6E63"
                android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <Button android:id="@+id/btn_acknowledge" android:text="OK"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="8dp"/>
        <TextView android:id="@+id/tv_acked" android:text="Lu" android:textSize="11sp"
            android:textColor="#2E7D32" android:visibility="gone"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>