<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_teal" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tv_welcome" android:text="Bonjour"
                android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFF"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            <Button android:id="@+id/btn_logout" android:text="Deconnexion"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:id="@+id/tv_alert_count" android:visibility="gone"
            android:background="#FFEB3B" android:textColor="#3D2C2C" android:padding="8dp"
            android:layout_marginTop="8dp" android:textSize="13sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="@color/surface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:text="Dernieres mesures" android:textSize="15sp"
                        android:textStyle="bold" android:textColor="@color/primary_dark"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"/>
                    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:columnCount="2">
                        <LinearLayout android:orientation="vertical" android:padding="8dp"
                            android:background="#FFF0F5" android:layout_margin="4dp"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1">
                            <TextView android:text="Tension" android:textSize="11sp" android:textColor="@color/text_secondary"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/tv_bp" android:text="--/-- mmHg"
                                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/primary"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout android:orientation="vertical" android:padding="8dp"
                            android:background="#F0FFF0" android:layout_margin="4dp"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1">
                            <TextView android:text="Glycemie" android:textSize="11sp" android:textColor="@color/text_secondary"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/tv_glucose" android:text="-- mg/dL"
                                android:textSize="15sp" android:textStyle="bold" android:textColor="#2E7D32"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout android:orientation="vertical" android:padding="8dp"
                            android:background="#F0F8FF" android:layout_margin="4dp"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1">
                            <TextView android:text="SpO2" android:textSize="11sp" android:textColor="@color/text_secondary"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/tv_spo2" android:text="--%"
                                android:textSize="15sp" android:textStyle="bold" android:textColor="#1565C0"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <LinearLayout android:orientation="vertical" android:padding="8dp"
                            android:background="#FFF8F0" android:layout_margin="4dp"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_columnWeight="1">
                            <TextView android:text="Freq. Cardiaque" android:textSize="11sp" android:textColor="@color/text_secondary"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:id="@+id/tv_hr" android:text="-- bpm"
                                android:textSize="15sp" android:textStyle="bold" android:textColor="#EF6C00"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </GridLayout>
                    <TextView android:id="@+id/tv_status" android:text="Etat normal"
                        android:textSize="13sp" android:textStyle="bold" android:textColor="@color/success"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:columnCount="2">
                <androidx.cardview.widget.CardView android:id="@+id/card_measure"
                    android:layout_width="0dp" android:layout_height="80dp"
                    android:layout_columnWeight="1" android:layout_margin="6dp"
                    app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFF0F5">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:text="+" android:textSize="24sp" android:textColor="@color/primary"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Nouvelle mesure" android:textSize="11sp"
                            android:textColor="@color/primary" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/card_history"
                    android:layout_width="0dp" android:layout_height="80dp"
                    android:layout_columnWeight="1" android:layout_margin="6dp"
                    app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#F0FFF0">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:text="Historique" android:textSize="11sp"
                            android:textColor="#2E7D32" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/card_alerts"
                    android:layout_width="0dp" android:layout_height="80dp"
                    android:layout_columnWeight="1" android:layout_margin="6dp"
                    app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFF8F0">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:text="Alertes" android:textSize="11sp"
                            android:textColor="@color/warning" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/card_appointments"
                    android:layout_width="0dp" android:layout_height="80dp"
                    android:layout_columnWeight="1" android:layout_margin="6dp"
                    app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#F0F0FF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:text="Rendez-vous" android:textSize="11sp"
                            android:textColor="#5C35CC" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/card_medications"
                    android:layout_width="0dp" android:layout_height="80dp"
                    android:layout_columnWeight="1" android:layout_margin="6dp"
                    app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#F5FFF0">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:text="Medicaments" android:textSize="11sp"
                            android:textColor="#388E3C" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/card_profile"
                    android:layout_width="0dp" android:layout_height="80dp"
                    android:layout_columnWeight="1" android:layout_margin="6dp"
                    app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFF5F0">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:text="Mon Profil" android:textSize="11sp"
                            android:textColor="@color/accent" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/card_ocr"
                    android:layout_width="0dp" android:layout_height="80dp"
                    android:layout_columnWeight="1" android:layout_margin="6dp"
                    app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#F0F8FF">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:text="OCR Ordonnance" android:textSize="11sp"
                            android:textColor="#1565C0" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/card_avatar"
                    android:layout_width="0dp" android:layout_height="80dp"
                    android:layout_columnWeight="1" android:layout_margin="6dp"
                    app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#FCE4EC">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center">
                        <TextView android:text="Conseiller IA" android:textSize="11sp"
                            android:textColor="#C2185B" android:textStyle="bold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </GridLayout>

            <androidx.cardview.widget.CardView android:id="@+id/card_sos"
                android:layout_width="match_parent" android:layout_height="70dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp" app:cardElevation="4dp"
                app:cardBackgroundColor="@color/sos_red">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="center" android:padding="16dp">
                    <TextView android:text="SOS - URGENCE" android:textSize="18sp"
                        android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
